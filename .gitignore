# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# *.meta files in the Assets folder and its subfolders now get ignored.
# Previously, *.csproj and sln files would not be ignored.
# Now they are ignored since Visual Studio files in Projects folder are now generated.
# Keeps only Assets structure in the repository. Previous structures (for example: base Unity project)
# gets removed by the changes in *.proj files. This might cause conflicts during pull/merge/rebase.
# 個人宅の対象物スキャンデータ（.arobject）はgit管理対象外
# 学生は各自の対象物を ar-solution-scanner-app でスキャンし、ローカルにのみ保持する
# 2026-10-22: Kettle/Miffy/Pet-bottle/banana を履歴含め完全除去済み（個人宅の物品画像由来データのため）
Assets/Models/Kettle/
Assets/Models/Kettle.meta
Assets/Models/Miffy/
Assets/Models/Miffy.meta
Assets/Models/Pet-bottle/
Assets/Models/Pet-bottle.meta
Assets/Models/banana/
Assets/Models/banana.meta

# Text Editor Usage
.vscode/
.idea/

# Swap
[._]*.s[a-v][a-z]
!*.svg  # comment out if you don't need vector files
[._]*.sw[a-p]
*~

# Temporary files
*.tmp
*.bak
*.swp

#################
### Unity stuff ###
#################
# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Ignore the Asset Store tools package
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
[Ll]ibrary/
[Ll]ocal[Cc]ache/
[Oo]bj/
[Tt]emp/
[Uu]ser[Ss]ettings/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Bb]uild/

# Never ignore asset metadata files, in case a file merge is required
![Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# [Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugins
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
[Ll]ibrary/
[Ll]ocal[Cc]ache/
[Oo]bj/
[Tt]emp/
[Uu]ser[Ss]ettings/

# Visual Studio cache/options directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
[Ll]ibrary/
[Ll]ocal[Cc]ache/
[Oo]bj/
[Tt]emp/

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# Mac specific
.DS_Store
*.swp
*~.nib

# Xcode
#
# gitignore contributors: remember to update the globalexclusions file after changing this file.
# Emoji: ⚠️ when adding line which collects userinformation
#
*.pbxproj
*.xcproj
*.xcworkspace
build/
DerivedData/
.DS_Store
*.hmap
*.ipa
*.app

# Xcode - User files
xcuserdata/
*.xcuserdatad/

*.moved-aside
*.perspectivev3
!default.perspectivev3

# Resolve Mac OS .DS_Store files
.DS_Store
